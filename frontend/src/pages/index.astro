---
import Layout from '../layouts/Layout.astro';
import { StarRating } from '../components/Interactive/StarRating.tsx';
import { TagManager } from '../components/Interactive/TagManager.tsx';
---

<Layout title="HOME | Filmee">
  <main class="max-w-4xl mx-auto p-6 space-y-10">
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="space-y-4">
        <h2 class="text-xl font-bold flex items-center gap-2">
          <span>⭐</span> レビュー
        </h2>
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
          <StarRating client:load />
        </div>
      </div>

      <div class="space-y-4">
        <h2 class="text-xl font-bold flex items-center gap-2">
          <span>🏷️</span> タグ
        </h2>
        <TagManager client:load />
      </div>
    </section>
  </main>
</Layout>